# Copia este archivo como .env y completa los valores.
# Solo las variables que empiezan con VITE_ llegan al frontend
# (y por eso son públicas: nunca pongas aquí claves secretas del servidor).

# URL del backend o del proyecto de Supabase cuando se conecte la base de datos
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
