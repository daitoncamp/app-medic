# Copia este archivo como .env (no se sube a GitHub)

# Conexión a PostgreSQL. Coincide con docker-compose.yml;
# si usas un PostgreSQL instalado en Windows, cambia usuario, clave y puerto.
DATABASE_URL="postgresql://clinica:clinica_dev@localhost:5432/clinica_dental?schema=public"

# Puerto de la API
PORT=3000

# Dirección del frontend (Vite) que puede llamar a la API
CORS_ORIGIN=http://localhost:5173

# development | production
NODE_ENV=development

# Contraseña inicial de los usuarios de prueba que crea el seed.
# Cada usuario debe cambiarla en su primer ingreso.
SEED_PASSWORD=Clinica2026!
